# --- Supabase (Project Settings → API) ---
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
# Service role key: server-side only, bypasses RLS. Never expose to the browser.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# --- Anthropic (Claude API) — powers the failure-diagnosis engine (Phase 3) ---
ANTHROPIC_API_KEY=sk-ant-...
# Optional model override (default: claude-opus-4-8)
# ANTHROPIC_MODEL=claude-opus-4-8

# --- App ---
NEXT_PUBLIC_APP_URL=http://localhost:3000
# Random token protecting cron endpoints (Vercel sends it as a Bearer token)
CRON_SECRET=generate-a-random-32-char-string
