# --- Supabase (Project Settings → API) ---
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
# Service role key: server-side only, bypasses RLS. Never expose to the browser.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# --- Stripe (Dashboard → Developers) ---
# Platform secret key (test mode until launch)
STRIPE_SECRET_KEY=sk_test_...
# Connect OAuth client id (Dashboard → Settings → Connect → Onboarding options → OAuth)
STRIPE_CONNECT_CLIENT_ID=ca_...
# Signing secret for the Connect webhook endpoint ("Listen to events on connected accounts")
STRIPE_WEBHOOK_SECRET=whsec_...

# --- App ---
NEXT_PUBLIC_APP_URL=http://localhost:3000
# Random token protecting the cron sweep endpoint (Vercel sends it as a Bearer token)
CRON_SECRET=generate-a-random-32-char-string
